# Frontend env. Copy to .env.local (gitignored) and edit per machine.

# Where the Vite dev server proxies /api, /graphql, /ws to.
# - Same machine as the backend (docker compose): default (http://localhost:8001) works.
# - Laptop hitting a remote backend over Tailscale: set this to the
#   backend host's Tailscale IP + port 8000 (tailscale serve bridges
#   :8000 → localhost:8001 on the backend host).
# Example:
# VITE_API_TARGET=http://100.83.42.67:8000

# OPTIONAL — bypass the proxy and have the browser hit the backend directly.
# DON'T do this for cookie-based auth: SameSite=Lax cookies won't ride on
# cross-origin fetch, and SameSite=None requires HTTPS. Only useful if you
# host the API on the same origin as the frontend.
# VITE_API_BASE=
